PORT=3000
# Ruta del archivo SQLite
DB_PATH=./data/crm.db
# Usuario gerente que se crea la primera vez que arranca (si no hay usuarios)
ADMIN_NAME=Gerente
ADMIN_EMAIL=gerente@maass.com
ADMIN_PASSWORD=cambia-esta-clave
# Clave que deben mandar los formularios en el header x-api-key o en ?key=
FORM_API_KEY=pon-una-clave-larga
# WhatsApp Cloud API (Meta)
WHATSAPP_VERIFY_TOKEN=pon-un-token
WHATSAPP_APP_SECRET=
# true cuando corra detrás de HTTPS
COOKIE_SECURE=false
